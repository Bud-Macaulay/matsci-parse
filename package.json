{
  "name": "matsci-parse",
  "version": "0.16.3",
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "bench": "vitest bench --outputJson=benchmarks/results.json",
    "bench:compare": "vitest bench --compare=benchmarks/results.json",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "docs": "typedoc --skipErrorChecking",
    "typecheck": "tsc --noEmit",
    "roundtrip:external": "vitest run tests/core/io/pseudo/roundtrip-external.test.ts --reporter=verbose"
  },
  "packageManager": "pnpm@11.5.3",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.9.1",
    "globals": "^17.2.0",
    "jsdom": "^29.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typedoc": "^0.28.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@spglib/moyo-wasm": "^0.18.0",
    "txml": "^6.0.3",
    "voro3d": "^0.0.7"
  },
  "description": "A TypeScript library and web toolset for parsing, transforming, and analyzing atomistic materials science data.",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bud-Macaulay/matsci-parse.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Bud-Macaulay/matsci-parse/issues"
  },
  "homepage": "https://github.com/Bud-Macaulay/matsci-parse#readme"
}
